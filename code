import numpy as np
from laplace_only import compute
import matplotlib.pyplot as plt

domaine, potentiel = compute('laby.jpg', 'out')

dx = 1
dy = 1
dt = 0.1

# Initialisation des matrices de vitesse #
u = np.zeros_like(potentiel)
v = np.zeros_like(potentiel)

# Différence arrière selon x
for i in range(potentiel.shape[0]):
    for j in range(1, potentiel.shape[1]): # 1, car on ne peut pas calculer la différence arrière pour j=0
        if domaine [i,j] == 1 or domaine[i,j] == 2:
            if domaine [i,j-1] == 0:
                u[i, j] = 0 #condition limite
            else :
                u[i, j] = (potentiel[i, j] - potentiel[i, j-1]) / dx
        else:
            if domaine [i,j-1] == 1:
                u[i, j] = 0 #condition limite
            else:
                u[i, j] = 0.

# Différence arrière selon y
for i in range(1, potentiel.shape[0]-1): # 1, car on ne peut pas calculer la différence arrière pour i=0 #
    for j in range(potentiel.shape[1]):
        if domaine [i,j] == 1 or domaine[i,j] == 2:
            if domaine [i+1,j] == 0:
                v[i, j] = 0  #condition limite
            else:
                v[i, j] = (potentiel[i, j] - potentiel[i+1, j]) / dy
        else:
            if domaine [i+1,j] == 1:
                v[i, j] = 0  #condition limite
            else:
                v[i, j] = 0.

# Fonction pour vérifier la divergence nulle du champ de vitesse
def verification_divergence(u, v, dx, dy):

    divergence = np.zeros_like(u)

    for i in range(1, u.shape[0]-1):
        for j in range(1, u.shape[1]-1):

            du_dx = (u[i, j+1] - u[i, j]) / dx
            dv_dy = (v[i-1, j] - v[i, j]) / dy

            divergence[i, j] = du_dx + dv_dy

    print("Divergence maximale :", np.max(np.abs(divergence)))

verification_divergence(u, v, dx, dy)

# Initialisation de la matrice concentration 
c = np.zeros_like(potentiel)

# Initialisation de la matrice de la dérivée temporelle de la concentration
dc_dt = np.zeros_like(c)

# Localisation de l'entrée du labyrinthe
entree = np.where(domaine[1, :] == 2)

# Condition limite de c à l'entrée du labyrinthe
c[1, entree[0]] = 1


# 3. CALCUL DES FLUX AUX FACES

def calcul_flux(c, u, v, domaine):

    flux_u = np.zeros_like(u, dtype=float)
    flux_v = np.zeros_like(v, dtype=float)


    # Flux à travers les faces verticales

    for i in range(c.shape[0]):
        for j in range(1, c.shape[1]):

            # Ecoulement vers la droite
            if u[i,j] > 0:
                flux_u[i,j] = u[i,j] * c[i,j-1]

            # Ecoulement vers la gauche ou nul
            else:
                flux_u[i,j] = u[i,j] * c[i,j]


    # Flux à travers les faces horizontales

    for i in range(c.shape[0] - 1):
        for j in range(c.shape[1]):

            # Ecoulement vers le bas
            if v[i,j] > 0:
                flux_v[i,j] = v[i,j] * c[i,j]

            # Ecoulement vers le haut ou nul
            else:
                flux_v[i,j] = v[i,j] * c[i+1,j]

    return flux_u, flux_v


# 4. CALCUL DE dc/dt PAR BILAN DE FLUX

def calcul_dc_dt(c, u, v, domaine, dx, dy):

    # Calcul de chaque flux une seule fois
    flux_u, flux_v = calcul_flux(c, u, v, domaine)

    dc_dt = np.zeros_like(c, dtype=float)

    for i in range(1, c.shape[0] - 1):
        for j in range(1, c.shape[1] - 1):

            # On calcule uniquement dans le domaine
            if domaine[i,j] == 1 or domaine[i,j] == 2:

                # Flux horizontal :
                # droite - gauche
                flux_x = (flux_u[i,j+1] - flux_u[i,j])

                # Flux vertical :
                # bas - haut
                flux_y = (flux_v[i,j] - flux_v[i-1,j])

                # Conservation de la concentration
                dc_dt[i,j] = -(flux_x / dx + flux_y / dy)

    return dc_dt

# 5. EVOLUTION TEMPORELLE

# Nombre total de pas de temps
nombre_pas = 10000

# Instants que l'on veut afficher
instants_affichage = [0, 500, 1000]

# Stockage des concentrations
resultats_c = {}

# On sauvegarde la concentration initiale
resultats_c[0] = c.copy()

# Evolution temporelle
for n in range(1, nombre_pas + 1):

    # Calcul de dc/dt
    dc_dt = calcul_dc_dt(c, u, v, domaine, dx, dy)

    # Euler explicite
    c = c + dt * dc_dt

    # Condition à l'entrée
    c[1, entree[0]] = 1

    # On sauvegarde les résultats aux instants voulus
    if n in instants_affichage:
        resultats_c[n] = c.copy()



fig, axes = plt.subplots(1, 3, figsize=(15, 5))

for ax, n in zip(axes, instants_affichage):
    c_affichage = resultats_c[n]
    c_affichage = np.ma.masked_where(domaine == 0, c_affichage)

    image = ax.imshow(
        c_affichage,
        origin='upper',
        cmap='viridis',
        vmin=0,
        vmax=1
    )

    ax.set_title(f"t = {n * dt:.1f}")
    ax.set_xlabel("x")
    ax.set_ylabel("y")

fig.colorbar(image, ax=axes, label="Concentration c")
plt.tight_layout()
plt.show()

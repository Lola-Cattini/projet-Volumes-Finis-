import numpy as np
from laplace_only import compute
import matplotlib.pyplot as plt
import numpy as np
import matplotlib.pyplot as plt

from laplace_only import compute
from vitesses import calculer_vitesses, afficher_champs_vitesse
from divergence import verification_divergence
from transport import calcul_flux, calcul_dc_dt

domaine, potentiel = compute('laby complexe.png', 'out')

dx = 1
dy = 1
dt = 0.1

u, v = calculer_vitesses(potentiel, domaine, dx, dy)

afficher_champs_vitesse(u, v, domaine)

divergence = verification_divergence(u, v, domaine, dx, dy)


# Initialisation de la matrice concentration 
c = np.zeros_like(potentiel)

# Initialisation de la matrice de la dérivée temporelle de la concentration
dc_dt = np.zeros_like(c)

# Localisation de l'entrée du labyrinthe
entree = np.where(domaine[1, :] == 2)

# Condition limite de c à l'entrée du labyrinthe
c[1, entree[0]] = 1


#EVOLUTION TEMPORELLE PAR EULER EXPLICITE

nombre_pas = 100
instants_affichage = [50, 100]
resultats_c = {0: c.copy()}

for n in range(1, nombre_pas + 1):

    # Calcul de dc/dt
    dc_dt = calcul_dc_dt(c, u, v, domaine, dx, dy)

    # Euler explicite
    c = c + dt * dc_dt

    # Condition à l'entrée
    c[1, entree[0]] = 1

    # On sauvegarde les résultats aux instants voulus
    if n in instants_affichage:
        resultats_c[n] = c.copy()



fig, axes = plt.subplots(1, 2, figsize=(15, 5))

for ax, n in zip(axes, instants_affichage):
    c_affichage = resultats_c[n]
    c_affichage = np.ma.masked_where(domaine == 0, c_affichage)

    image = ax.imshow(
        c_affichage,
        origin='upper',
        cmap='viridis',
        vmin=0,
        vmax=1
    )

    ax.set_title(f"t = {n * dt:.1f}")
    ax.set_xlabel("x")
    ax.set_ylabel("y")

fig.colorbar(image, ax=axes, label="Concentration c")

plt.show()



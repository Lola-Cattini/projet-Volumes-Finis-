#Cas général
domaine, potentiel = compute('laby complexe.png', 'out')

# ============================================================
# 2. PARAMÈTRES
# ============================================================

dx = 1
dy = 1
Cr = 0.9
nombre_pas = 15000
instants_affichage = [8000, 15000]

# Indices de la cellule pour laquelle on compare les deux  méthodes
i = 370
j = 360

# ============================================================
# 3. CALCUL DES VITESSES
# ============================================================
"""
# CAS 1 : CHEMIN VERTICAL
